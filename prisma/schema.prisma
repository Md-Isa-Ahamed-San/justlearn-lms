// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enums

enum QuizStatus {
  draft
  published
}

enum QuestionType {
  mcq
  short_answer
  long_answer
}

enum AttemptStatus {
  not_started
  in_progress
  completed
}

enum QuizAccessType {
  instructor_created
  student_personal
}

enum Role {
  student
  instructor
  admin
}

enum Visibility {
  public
  private
}

// NEW: Quiz generation type enum

// MARK: User
model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String? // Optional for OAuth users
  provider   String? // "google", "credentials", etc.
  providerId String?
  image      String?
  role       Role?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  instructor       Instructor?       @relation("UserInstructor")
  student          Student?          @relation("UserStudent")
  admin            Admin?            @relation("UserAdmin")
  courses          Course[]          @relation("UserCourses")
  testimonials     Testimonial[]     @relation("UserTestimonials")
  quizSubmissions  QuizSubmission[]  @relation("UserQuizSubmissions")
  createdQuizzes   Quiz[]            @relation("UserCreatedQuizzes")
  aiGenerationLogs AIGenerationLog[] @relation("UserAILogs")
  courseProgress   CourseProgress[]  @relation("UserCourseProgress")
  certificates     Certificate[]     @relation("UserCertificates")
  reports          Report[]          @relation("UserReports")
  participations   Participation[]   @relation("UserParticipations")
  watches          Watch[]           @relation("UserWatches")
  liveSessions     Live[]            @relation("UserLiveSessions")
  aiQuizTemplates  AIQuizTemplate[]  @relation("UserAIQuizTemplates")

  @@index([role, isActive])
  @@index([createdAt])
}

// MARK: Instructor
model Instructor {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  idNumber   Int    @unique
  department String

  phone                String?
  bio                  String?
  designation          String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserInstructor", fields: [userId], references: [id])
}

// MARK: Student
model Student {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  idNumber   Int    @unique
  session    String
  department String

  phone                String?
  bio                  String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserStudent", fields: [userId], references: [id])
}

// MARK: Admin
model Admin {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  idNumber   Int    @unique
  department String

  phone                String?
  bio                  String?
  designation          String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserAdmin", fields: [userId], references: [id])
}

// MARK: Category
model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  thumbnail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  courses Course[]
}

// MARK: Course
model Course {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  subtitle    String?
  thumbnail   String
  active      Boolean    @default(true)
  learning    Json // Array of learning outcomes
  rating      Float?     @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  code        String
  visibility  Visibility

  // Foreign Keys
  userId     String @db.ObjectId
  categoryId String @db.ObjectId

  // Relationships
  user           User             @relation("UserCourses", fields: [userId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  weeks          Week[]
  testimonials   Testimonial[]    @relation("CourseTestimonials")
  certificates   Certificate[]    @relation("CourseCertificates")
  courseProgress CourseProgress[] @relation("CourseCourseProgress")
  reports        Report[]         @relation("CourseReports")
  participations Participation[]  @relation("CourseParticipations")
}

// MARK: Week
model Week {
  id                          String   @id @default(auto()) @map("_id") @db.ObjectId
  title                       String
  description                 String?
  status                      String   @default("not-active")
  slug                        String
  duration                    Int
  order                       Int
  aiQuizContextPrompt         String? // Context prompt for AI quiz generation
  aiQuizDefaultNumMCQ         Int?     @default(5)
  aiQuizDefaultNumShortAnswer Int?     @default(2)
  quizIds                     String[] @db.ObjectId // Array of quiz IDs
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId

  // Relationships
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         Lesson[]
  resources       Resource[]
  watches         Watch[]
  aiQuizTemplates AIQuizTemplate[] @relation("WeekAITemplates")

  // index
  @@index([quizIds])
}


enum QuizGenerationType {
  manual
  ai_fixed
  ai_pool // Type 3: AI generates pool(n number of quiz questions), students get random subset
}

// MARK: Quiz 
model Quiz {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  status      QuizStatus  @default(draft)

  active      Boolean     @default(true)
  weekIds     String[]    @db.ObjectId

  // NEW: Question Pool Configuration
  generationType      QuizGenerationType? @default(ai_pool)
  poolSize            Int?                @default(50)
  questionsPerStudent Int?                @default(10)

  // AI Generation fields
  aiPrompt               String? // Custom prompt from instructor or stored prompt
  aiContextData          Json? // Week content, lessons, resources for AI context
  targetMcqCount         Int?    @default(5)
  // Time and attempt controls
  timeLimit              Int?    @default(5) // Time limit in minutes
  maxAttempts            Int?    @default(1)
  showResultsImmediately Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  createdByUserId String @db.ObjectId

  // Relationships
  createdBy User @relation("UserCreatedQuizzes", fields: [createdByUserId], references: [id])

  questions        Question[]
  submissions      QuizSubmission[]
  aiGenerationLogs AIGenerationLog[]
  liveSession      Live?             @relation("QuizLiveSession")

  //Indexing to speed up queries
  @@index([status, active])
  @@index([createdByUserId, createdAt])
  @@index([weekIds]) // Index for the weekIds array
  @@index([generationType]) // NEW: Index for question pool queries
}

// MARK: Lesson
model Lesson {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  duration    Int      @default(0)
  videoUrl    String?  @map("video_url")
  active      Boolean  @default(false)
  slug        String
  access      String   @default("private")
  order       Int      @default(0)
  attachments Json? // Array of attachment objects
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  weekId String @db.ObjectId

  // Relationships
  week    Week    @relation(fields: [weekId], references: [id])
  watches Watch[]
}

// MARK: Question
model Question {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  type          QuestionType @default(mcq)
  text          String // The actual question text
  options       Json? // Array of options for MCQ (null for short/long answer)
  correctAnswer Json // Correct answer(s), e.g., "A", or ["A", "C"] for MCQ, text for others
  mark          Int          @default(1)
  order         Int          @default(0)

  // Question Pool fields
  isFromPool Boolean @default(false) // True if this question is part of an AI-generated pool

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  quizId String @db.ObjectId

  // Relationships
  quiz           Quiz            @relation(fields: [quizId], references: [id])
  studentAnswers StudentAnswer[]

  @@index([quizId, isFromPool])
  @@index([quizId, order]) // Additional index for question ordering
}

// Removed StudentQuizQuestion table - using client-side random selection instead

// MARK: AIQuizTemplate
model AIQuizTemplate {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  description             String?
  instructorPrompt        String
  defaultMcqCount         Int      @default(5)
  defaultShortAnswerCount Int      @default(2)
  defaultLongAnswerCount  Int      @default(1)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Foreign Keys
  userId String @db.ObjectId
  weekId String @db.ObjectId

  // Relationships
  user User @relation("UserAIQuizTemplates", fields: [userId], references: [id])
  week Week @relation("WeekAITemplates", fields: [weekId], references: [id])
}
enum SubmissionReason {
  manual_submit
  time_expired
  tab_switch_auto_submit
  minimize_auto_submit
  offline_auto_submit
  browser_close_auto_submit
  focus_loss_auto_submit
}
// MARK: QuizSubmission
model QuizSubmission {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  startTime     DateTime?
  endTime       DateTime?
  status        AttemptStatus @default(not_started)
  score         Float?        @default(0)
  attemptNumber Int           @default(1)
  timeSpent     Int? // Time spent in seconds
    submissionReason    SubmissionReason @default(manual_submit)
  suspiciousActivities Json?           // Array of activities: [{action: "tab_switch", timestamp: "2024-01-01T10:00:00Z"}, ...]
  tabSwitchCount      Int             @default(0)
  minimizeCount       Int             @default(0)
  offlineCount        Int             @default(0)
  totalViolations     Int             @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Foreign Keys
  userId String @db.ObjectId
  quizId String @db.ObjectId

  // Relationships
  user           User            @relation("UserQuizSubmissions", fields: [userId], references: [id])
  quiz           Quiz            @relation(fields: [quizId], references: [id])
  studentAnswers StudentAnswer[]
  // Removed studentQuizQuestions - using client-side random selection
}

// MARK: StudentAnswer
model StudentAnswer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  submittedAnswer Json // What the student chose/wrote
  isCorrect       Boolean  @default(false)
  marksAwarded    Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Foreign Keys
  questionId       String @db.ObjectId
  quizSubmissionId String @db.ObjectId

  // Relationships
  question       Question       @relation(fields: [questionId], references: [id])
  quizSubmission QuizSubmission @relation(fields: [quizSubmissionId], references: [id])
}

// MARK: AIGenerationLog
model AIGenerationLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  requestType      String // 'instructor_quiz', 'student_quiz'
  prompt           String
  contextData      Json?
  response         Json?
  status           String // 'success', 'failed', 'partial'
  errorMessage     String?
  tokensUsed       Int?
  processingTimeMs Int?
  createdAt        DateTime @default(now())

  // Foreign Keys
  quizId            String? @db.ObjectId
  requestedByUserId String  @db.ObjectId

  // Relationships
  quiz        Quiz? @relation(fields: [quizId], references: [id])
  requestedBy User  @relation("UserAILogs", fields: [requestedByUserId], references: [id])
}

// MARK: CourseProgress
model CourseProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  status    String   @default("not_started")
  progress  Float    @default(0) // 0-100 percentage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserCourseProgress", fields: [userId], references: [id])
  course Course @relation("CourseCourseProgress", fields: [courseId], references: [id])
}

// MARK: Certificate
model Certificate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateLink String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserCertificates", fields: [userId], references: [id])
  course Course @relation("CourseCertificates", fields: [courseId], references: [id])
}

// MARK: Testimonial
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  rating    Int?     @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserTestimonials", fields: [userId], references: [id])
  course Course @relation("CourseTestimonials", fields: [courseId], references: [id])
}

// MARK: Report
model Report {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  totalCompletedLessons Json // JSON array tracking lesson completion
  totalCompletedModules Json // JSON array tracking module completion
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId
  userId   String @db.ObjectId

  // Relationships
  course Course @relation("CourseReports", fields: [courseId], references: [id])
  user   User   @relation("UserReports", fields: [userId], references: [id])
}

// MARK: Participation
model Participation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  progress  Json // JSON storing various engagement data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId
  userId   String @db.ObjectId

  // Relationships
  course Course @relation("CourseParticipations", fields: [courseId], references: [id])
  user   User   @relation("UserParticipations", fields: [userId], references: [id])
}

// MARK: Watch
model Watch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  state     String   @default("started")
  lastTime  Int      @default(0) // Seconds watched
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  lessonId String  @db.ObjectId
  userId   String  @db.ObjectId
  weekId   String? @db.ObjectId

  // Relationships
  lesson Lesson @relation(fields: [lessonId], references: [id])
  user   User   @relation("UserWatches", fields: [userId], references: [id])
  week   Week?  @relation(fields: [weekId], references: [id])
}

// MARK: Resource
model Resource {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  type      String // "text", "pdf", "video", "link"
  url       String?
  content   String? // For text resources
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  weekId String @db.ObjectId

  // Relationships
  week Week @relation(fields: [weekId], references: [id])
}

// MARK: Live Sessions
model Live {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  thumbnail   String?
  videoId     String   @map("video_id")
  slug        String
  schedule    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  quizId String? @unique @db.ObjectId
  userId String  @db.ObjectId

  // Relationships
  quiz Quiz? @relation("QuizLiveSession", fields: [quizId], references: [id])
  user User  @relation("UserLiveSessions", fields: [userId], references: [id])
}
