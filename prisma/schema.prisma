// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  student
  instructor
  admin
}

// MARK: User
model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  email      String   @unique
  password   String? //Optional for Oauth users(google signin users)
  provider   String? // "google", "credentials", etc.
  providerId String? // Provider's user ID
  image String?
  role       Role?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  instructor   Instructor?   @relation("UserInstructor")
  student      Student?      @relation("UserStudent")
  admin        Admin?        @relation("UserAdmin")
  courses      Course[]      @relation("UserCourses") // User can have multiple courses (if they are instructor)
  testimonials Testimonial[] @relation("UserTestimonials") // Added: Missing relation field
}

// MARK: Course
model Course {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  subtitle    String?
  thumbnail   String
  price       Int
  active      Boolean  @default(true)
  learning    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  userId     String @db.ObjectId // References User.id
  categoryId String @db.ObjectId

  // Relationships
  user     User     @relation("UserCourses", fields: [userId], references: [id]) // Added: Course belongs to User
  category Category @relation(fields: [categoryId], references: [id])

  weeks          Week[]
  testimonials   Testimonial[]   @relation("CourseTestimonials")
  enrollments    Enrollment[]
  certificates   Certificate[]
  reports        Report[]
  participations Participation[]
  courseQuizSets CourseQuizSet[] // Junction table relation
}

// MARK: Instructor
model Instructor {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  department           String
  isActive             Boolean   @default(true)
  phone                String?
  bio                  String?
  designation          String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserInstructor", fields: [userId], references: [id])
}

// MARK: Student
model Student {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  session              String
  department           String
  isActive             Boolean   @default(true)
  phone                String?
  bio                  String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user         User          @relation("UserStudent", fields: [userId], references: [id])
  enrollments  Enrollment[]
  certificates Certificate[]
  watches      Watch[]

  reports        Report[]
  feedbacks      Feedback[]
  participations Participation[]
}

// MARK: Admin
model Admin {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  isActive             Boolean   @default(true)
  phone                String?
  bio                  String?
  designation          String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserAdmin", fields: [userId], references: [id])
}

// MARK: Enrollment
model Enrollment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentDate DateTime  @map("enrollment_date")
  status         String
  completionDate DateTime? @map("completion_date")
  method         String
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt

  // Foreign Keys
  courseId  String @db.ObjectId
  studentId String @db.ObjectId

  // Relations
  course       Course        @relation(fields: [courseId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  certificates Certificate[]
}

// MARK: Certificate 
model Certificate {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  certificateLink String    @map("certificate_link")
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt

  // Foreign Keys
  studentId    String @db.ObjectId
  courseId     String @db.ObjectId
  enrollmentId String @db.ObjectId

  // Relations
  student    Student    @relation(fields: [studentId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
}

// MARK: Watch
model Watch {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  state     String    @default("started")
  lastTime  Int       @map("last_time")
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  lessonId  String  @db.ObjectId
  studentId String  @db.ObjectId
  weekId    String? @db.ObjectId

  // Relations
  lesson  Lesson  @relation(fields: [lessonId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  week    Week?   @relation(fields: [weekId], references: [id])
}

// MARK: Testimonial 
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserTestimonials", fields: [userId], references: [id])
  course Course @relation("CourseTestimonials", fields: [courseId], references: [id])
}

// MARK: Report
model Report {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  totalCompletedLessons String[] @db.ObjectId
  totalCompletedModules String[] @map("totalCompletedModeules") @db.ObjectId

  // Foreign Keys
  courseId     String  @db.ObjectId
  studentId    String  @db.ObjectId
  assessmentId String? @unique @db.ObjectId

  // Relations
  course     Course      @relation(fields: [courseId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  assessment Assessment? @relation(name: "ReportAssessment", fields: [assessmentId], references: [id])
}

// MARK: Feedback 
model Feedback {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  quizScore   Float
  suggestions String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Foreign Keys
  studentId String @db.ObjectId
  weekId    String @db.ObjectId

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  week    Week    @relation(fields: [weekId], references: [id])
}

// MARK: Participation
model Participation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  progress  Json[] // Array of {weekId, completed, score}
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  courseId  String @db.ObjectId
  studentId String @db.ObjectId

  // Relations
  course  Course  @relation(fields: [courseId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
}

// MARK: Category 
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  thumbnail   String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  courses     Course[]
}

// MARK: Week
model Week {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      String    @default("not-active")
  slug        String
  duration    Int
  order       Int // Added: For sequencing weeks
  quizPrompt  String? // Added: Instructor's prompt for AI quiz
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId

  // Relations
  course    Course     @relation(fields: [courseId], references: [id])
  lessons   Lesson[]
  resources Resource[] // Added relation
  watches   Watch[]
  feedbacks Feedback[] // Added relation
  quizzes   Quiz[] // Added relation
}

// MARK: Lesson
model Lesson {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  duration    Int       @default(0)
  videoUrl    String?   @map("video_url")
  active      Boolean   @default(false)
  slug        String
  access      String    @default("private")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Foreign Keys
  weekId String @db.ObjectId

  // Relations
  week    Week    @relation(fields: [weekId], references: [id])
  watches Watch[]
}

// MARK: Quiz
model Quiz {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  version     Int       @default(1) // For quiz versioning
  published   Boolean   @default(false) // Published/draft status
  slug        String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Foreign Keys
  weekId String? @db.ObjectId

  // Relations
  week            Week?            @relation(fields: [weekId], references: [id])
  questions       Question[] // Added relation
  quizSetItems    QuizSetItem[] // Junction table relation
  assessmentItems AssessmentItem[]
}

// MARK: QuizSet
model QuizSet {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  slug        String
  active      Boolean   @default(false)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Relations
  quizSetItems QuizSetItem[] // Junction table relation
  courseItems  CourseQuizSet[] // Junction table relation
}

// MARK: QuizSetItem (Junction table for Quiz <-> QuizSet)
model QuizSetItem {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  quizId    String @db.ObjectId
  quizSetId String @db.ObjectId

  // Relations
  quiz    Quiz    @relation(fields: [quizId], references: [id])
  quizSet QuizSet @relation(fields: [quizSetId], references: [id])
}

// MARK: CourseQuizSet (Junction table for Course <-> QuizSet)
model CourseQuizSet {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  courseId  String @db.ObjectId
  quizSetId String @db.ObjectId

  // Relations
  course  Course  @relation(fields: [courseId], references: [id])
  quizSet QuizSet @relation(fields: [quizSetId], references: [id])
}

// MARK: Question
model Question {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  type        String // "MCQ", "TF", "short"
  prompt      String
  choices     Json? // For MCQ questions
  answer      String
  explanation String // AI-generated explanation
  mark        Int       @default(1)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  // Foreign Keys
  quizId String @db.ObjectId

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id])
}

// MARK: Resource
model Resource {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  type      String // "text", "pdf", "video", "link"
  url       String?
  content   String? // For text resources
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  weekId String @db.ObjectId

  // Relations
  week Week @relation(fields: [weekId], references: [id])
}

// MARK: Assessment
model Assessment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  otherMarks Int
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  // Relations
  items  AssessmentItem[]
  report Report?          @relation(name: "ReportAssessment")
}

// MARK: AssessmentItem
model AssessmentItem {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  attempted Boolean   @default(false)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Foreign Keys
  quizId       String @db.ObjectId
  assessmentId String @db.ObjectId

  // Relations
  quiz       Quiz       @relation(fields: [quizId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  options    Option[] // one-to-many
}

// MARK: Option
model Option {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  option     String
  isCorrect  Boolean
  isSelected Boolean
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  // Foreign Keys
  assessmentItemId String @db.ObjectId

  // Relations
  assessmentItem AssessmentItem @relation(fields: [assessmentItemId], references: [id])
}

// MARK: Live Sessions
model Live {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  thumbnail    String
  videoId      String    @map("video_id")
  slug         String
  schedule     DateTime
  quizId       String?   @map("quiz_id")
  instructorId String    @map("instructor_id") @db.ObjectId // Fixed: Added @db.ObjectId and should reference Instructor.id
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  // Relations (Optional: Add if you want to enforce referential integrity)
  // instructor   Instructor @relation(fields: [instructorId], references: [id])
}
