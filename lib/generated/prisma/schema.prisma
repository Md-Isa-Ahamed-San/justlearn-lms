// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enums
enum QuizStatus {
  draft
  published
}

enum QuestionType {
  mcq
  short_answer
  long_answer
}

enum AttemptStatus {
  not_started
  in_progress
  completed
}

enum QuizAccessType {
  instructor_created
  student_personal
}

enum Role {
  student
  instructor
  admin
}

enum Visibility {
  public
  private
}

enum QuizGenerationType {
  manual
  ai_fixed
  ai_pool
}

enum SubmissionReason {
  manual_submit
  time_expired
  tab_switch_auto_submit
  minimize_auto_submit
  offline_auto_submit
  browser_close_auto_submit
  focus_loss_auto_submit
}

// Core Tables
model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String?
  provider   String?
  providerId String?
  image      String?
  role       Role?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  instructor       Instructor?       @relation("UserInstructor")
  student          Student?          @relation("UserStudent")
  admin            Admin?            @relation("UserAdmin")
  courses          Course[]          @relation("UserCourses")
  testimonials     Testimonial[]     @relation("UserTestimonials")
  quizSubmissions  QuizSubmission[]  @relation("UserQuizSubmissions")
  createdQuizzes   Quiz[]            @relation("UserCreatedQuizzes")
  aiGenerationLogs AIGenerationLog[] @relation("UserAILogs")
  courseProgress   CourseProgress[]  @relation("UserCourseProgress")
  certificates     Certificate[]     @relation("UserCertificates")
  reports          Report[]          @relation("UserReports")
  participations   Participation[]   @relation("UserParticipations")
  watches          Watch[]           @relation("UserWatches")
  liveSessions     Live[]            @relation("UserLiveSessions")

  @@index([role, isActive])
  @@index([createdAt])
}

model Instructor {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  department           String
  phone                String?
  bio                  String?
  designation          String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserInstructor", fields: [userId], references: [id])
}

model Student {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  session              String
  department           String
  phone                String?
  bio                  String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserStudent", fields: [userId], references: [id])
}

model Admin {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  idNumber             Int       @unique
  department           String
  phone                String?
  bio                  String?
  designation          String?
  profilePicture       String?
  socialMedia          Json?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Key
  userId String @unique @db.ObjectId

  // Relationships
  user User @relation("UserAdmin", fields: [userId], references: [id])
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  thumbnail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  courses Course[]
}

model Course {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  subtitle    String?
  thumbnail   String
  active      Boolean    @default(true)
  learning    Json // Array of learning outcomes
  rating      Float?     @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  code        String
  visibility  Visibility

  // Foreign Keys
  userId     String @db.ObjectId
  categoryId String @db.ObjectId

  // Relationships
  user           User             @relation("UserCourses", fields: [userId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  weeks          Week[]
  testimonials   Testimonial[]    @relation("CourseTestimonials")
  certificates   Certificate[]    @relation("CourseCertificates")
  courseProgress CourseProgress[] @relation("CourseCourseProgress")
  reports        Report[]         @relation("CourseReports")
  participations Participation[]  @relation("CourseParticipations")
}

model Week {
  id                          String   @id @default(auto()) @map("_id") @db.ObjectId
  title                       String
  description                 String?
  status                      String   @default("not-active")
  slug                        String
  duration                    Int
  order                       Int
  aiQuizContextPrompt         String?
  aiQuizDefaultNumMCQ         Int?     @default(5)
  aiQuizDefaultNumShortAnswer Int?     @default(2)
  quizIds                     String[] @db.ObjectId // Array of quiz IDs
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId

  // Relationships
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  watches Watch[]

  @@index([quizIds])
}

model Quiz {
  id                     String              @id @default(auto()) @map("_id") @db.ObjectId
  title                  String
  description            String
  status                 QuizStatus          @default(draft)
  active                 Boolean             @default(true)
  weekIds                String[]            @db.ObjectId
  generationType         QuizGenerationType? @default(ai_pool)
  poolSize               Int?                @default(50)
  questionsPerStudent    Int?                @default(10)
  aiPrompt               String?
  aiContextData          Json?
  aiContextFiles         String[]
  targetMcqCount         Int?                @default(5)
  timeLimit              Int?                @default(5)
  maxAttempts            Int?                @default(1)
  showResultsImmediately Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  // Foreign Keys
  createdByUserId String @db.ObjectId

  // Relationships
  createdBy        User              @relation("UserCreatedQuizzes", fields: [createdByUserId], references: [id])
  questions        Question[]
  submissions      QuizSubmission[]
  aiGenerationLogs AIGenerationLog[]
  liveSession      Live?             @relation("QuizLiveSession")

  @@index([status, active])
  @@index([createdByUserId, createdAt])
  @@index([weekIds])
  @@index([generationType])
}

model Lesson {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  duration    Int      @default(0)
  videoUrl    String?  @map("video_url")
  active      Boolean  @default(false)
  slug        String
  access      String   @default("private")
  order       Int      @default(0)
  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  weekId String @db.ObjectId

  // Relationships
  week    Week    @relation(fields: [weekId], references: [id])
  watches Watch[]
}

model Question {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  type          QuestionType @default(mcq)
  text          String
  image         String?
  explanation   String?
  options       Json?
  correctAnswer Json
  mark          Int          @default(1)
  order         Int          @default(0)
  isFromPool    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Foreign Keys
  quizId String @db.ObjectId

  // Relationships
  quiz           Quiz            @relation(fields: [quizId], references: [id])
  studentAnswers StudentAnswer[]

  @@index([quizId, isFromPool])
  @@index([quizId, order])
}

model QuizSubmission {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  startTime            DateTime?
  endTime              DateTime?
  status               AttemptStatus    @default(not_started)
  score                Float?           @default(0)
  attemptNumber        Int              @default(1)
  timeSpent            Int?
  submissionReason     SubmissionReason @default(manual_submit)
  suspiciousActivities Json?
  tabSwitchCount       Int              @default(0)
  minimizeCount        Int              @default(0)
  offlineCount         Int              @default(0)
  totalViolations      Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Foreign Keys
  userId String @db.ObjectId
  quizId String @db.ObjectId

  // Relationships
  user           User            @relation("UserQuizSubmissions", fields: [userId], references: [id])
  quiz           Quiz            @relation(fields: [quizId], references: [id])
  studentAnswers StudentAnswer[]
}

model StudentAnswer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  submittedAnswer Json
  isCorrect       Boolean  @default(false)
  marksAwarded    Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Foreign Keys
  questionId       String @db.ObjectId
  quizSubmissionId String @db.ObjectId

  // Relationships
  question       Question       @relation(fields: [questionId], references: [id])
  quizSubmission QuizSubmission @relation(fields: [quizSubmissionId], references: [id])
}

model AIGenerationLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  requestType      String
  prompt           String
  contextData      Json?
  response         Json?
  status           String
  errorMessage     String?
  tokensUsed       Int?
  processingTimeMs Int?
  createdAt        DateTime @default(now())

  // Foreign Keys
  quizId            String? @db.ObjectId
  requestedByUserId String  @db.ObjectId

  // Relationships
  quiz        Quiz? @relation(fields: [quizId], references: [id])
  requestedBy User  @relation("UserAILogs", fields: [requestedByUserId], references: [id])
}

model CourseProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  status    String   @default("not_started")
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserCourseProgress", fields: [userId], references: [id])
  course Course @relation("CourseCourseProgress", fields: [courseId], references: [id])
}

model Certificate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateLink String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserCertificates", fields: [userId], references: [id])
  course Course @relation("CourseCertificates", fields: [courseId], references: [id])
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  rating    Int?     @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId   String @db.ObjectId
  courseId String @db.ObjectId

  // Relationships
  user   User   @relation("UserTestimonials", fields: [userId], references: [id])
  course Course @relation("CourseTestimonials", fields: [courseId], references: [id])
}

model Report {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  totalCompletedLessons Json
  totalCompletedModules Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId
  userId   String @db.ObjectId

  // Relationships
  course Course @relation("CourseReports", fields: [courseId], references: [id])
  user   User   @relation("UserReports", fields: [userId], references: [id])
}

model Participation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  progress  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  courseId String @db.ObjectId
  userId   String @db.ObjectId

  // Relationships
  course Course @relation("CourseParticipations", fields: [courseId], references: [id])
  user   User   @relation("UserParticipations", fields: [userId], references: [id])
}

model Watch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  state     String   @default("started")
  lastTime  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  lessonId String  @db.ObjectId
  userId   String  @db.ObjectId
  weekId   String? @db.ObjectId

  // Relationships
  lesson Lesson @relation(fields: [lessonId], references: [id])
  user   User   @relation("UserWatches", fields: [userId], references: [id])
  week   Week?  @relation(fields: [weekId], references: [id])
}

model Live {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  thumbnail   String?
  videoId     String   @map("video_id")
  slug        String
  schedule    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  quizId String? @unique @db.ObjectId
  userId String  @db.ObjectId

  // Relationships
  quiz Quiz? @relation("QuizLiveSession", fields: [quizId], references: [id])
  user User  @relation("UserLiveSessions", fields: [userId], references: [id])
}
